# Copy to .env (git-ignored) and fill in. The API, the worker and the optional live tests read these as plain
# environment variables; real environment variables always win over this file. NEVER commit .env or paste values elsewhere.

# Which provider new processes use: Simulated (default, no credentials needed), DocuSign or Lacuna.
# Processes already created keep the provider they started with.
Provider__Default=Simulated

# ---- DocuSign eSignature (demo / developer sandbox) ---------------------------------------------------------------
# Create an app in https://admindemo.docusign.com (Settings > Apps and Keys): the Integration Key, an RSA key pair and
# a one-time consent for the impersonated user (https://account-d.docusign.com/oauth/auth?response_type=code&scope=signature%20impersonation&client_id=<key>&redirect_uri=<uri>).
DOCUSIGN_INTEGRATION_KEY=
# GUID of the user the integration impersonates (API Username in Apps and Keys).
DOCUSIGN_USER_ID=
# API Account ID (GUID) of the demo account.
DOCUSIGN_ACCOUNT_ID=
# RSA private key (PEM). Either inline with \n for line breaks, or point to a file (the file wins when both are set).
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_FILE=./docusign-private.pem
# Demo endpoints (production uses the account's own base URI and account.docusign.com).
DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
# HMAC key configured in Connect (Settings > Connect > Add configuration > Include HMAC signature), JSON (SIM) events.
# Connect URL: https://<your-public-host>/v1/webhooks/docusign
DOCUSIGN_CONNECT_HMAC_KEY=

# ---- Lacuna Signer (demo environment) -----------------------------------------------------------------------------
# API key in the form "<application name>|<key>" (sent as X-Api-Key).
LACUNA_API_KEY=
LACUNA_BASE_URI=https://signer-lac.azurewebsites.net
# Shared secret the webhook must send in X-Webhook-Secret. Webhook URL: https://<your-public-host>/v1/webhooks/lacuna
LACUNA_WEBHOOK_SECRET=
