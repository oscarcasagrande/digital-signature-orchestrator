{
  "realm": "orchestrator",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "viewer" },
      { "name": "operator" },
      { "name": "client" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "portal",
      "name": "Operations portal (demo)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/auth/callback", "http://localhost:5173/auth/callback"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "orchestrator-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "orchestrator-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "orchestrator-cli",
      "name": "Scripts and smoke test (demo, password grant, development only)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "orchestrator-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "orchestrator-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "orchestrator-client-a",
      "name": "Demo machine client A",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-secret-client-a-change-me",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "orchestrator-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "orchestrator-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "orchestrator-client-b",
      "name": "Demo machine client B",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-secret-client-b-change-me",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "orchestrator-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "orchestrator-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-orchestrator-client-a",
      "enabled": true,
      "serviceAccountClientId": "orchestrator-client-a",
      "realmRoles": ["client"]
    },
    {
      "username": "service-account-orchestrator-client-b",
      "enabled": true,
      "serviceAccountClientId": "orchestrator-client-b",
      "realmRoles": ["client"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Viewer",
      "email": "viewer@example.test",
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["viewer"]
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Operator",
      "email": "operator@example.test",
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "email": "admin@example.test",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin", "operator"]
    }
  ]
}
