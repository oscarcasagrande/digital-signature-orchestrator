{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Postgres": "Host=localhost;Port=5433;Database=orchestrator;Username=orchestrator;Password=orchestrator" },
  "Idempotency": { "RetentionHours": 24 },
  "Workflow": { "PollIntervalSeconds": 2 },
  "Retry": { "Jitter": 0.2, "UnknownMaxAttempts": 3 },
  "Callbacks": { "TimeoutSeconds": 10, "RateLimitPerSecond": 10, "SignatureToleranceSeconds": 300 },
  "Identity": { "MaxEvidenceBytes": 5242880, "EvidenceRetentionDays": 30, "RetentionSweepMinutes": 60 },
  "Reconciliation": { "Enabled": true, "IntervalSeconds": 60, "StaleAfterSeconds": 120, "BatchSize": 50 },
  "Sla": { "SigningMinutes": 60 },
  "FakeProvider": { "Mode": "Auto", "SignDelaySeconds": 2 },
  "Artifacts": { "PublicBaseUrl": "http://localhost:8080", "LinkTtlSeconds": 300, "MaxDocumentBytes": 52428800, "FetchTimeoutSeconds": 30 },
  "S3": { "Endpoint": "http://localhost:9000", "AccessKey": "minioadmin", "SecretKey": "minioadmin", "Bucket": "signature-artifacts" }
}
